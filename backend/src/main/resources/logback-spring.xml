<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ========================================================= -->
    <!-- Properties -->
    <!-- ========================================================= -->

    <property name="LOG_PATH" value="logs"/>

    <!-- ========================================================= -->
    <!-- Development Console (Human Readable) -->
    <!-- ========================================================= -->

    <appender name="CONSOLE_DEV"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">

            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{40}) req=%X{requestId:-N/A} user=%X{username:-anonymous} %magenta(%X{method:-}) %blue(%X{path:-}) - %msg%n</pattern>

        </encoder>

    </appender>

    <!-- ========================================================= -->
    <!-- Production Console (JSON) -->
    <!-- ========================================================= -->

    <appender name="CONSOLE_JSON"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder class="net.logstash.logback.encoder.LogstashEncoder">

            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>username</includeMdcKeyName>
            <includeMdcKeyName>method</includeMdcKeyName>
            <includeMdcKeyName>path</includeMdcKeyName>

            <!-- Uncomment when Micrometer Tracing is enabled -->
            <!--
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            -->

        </encoder>

    </appender>

    <!-- ========================================================= -->
    <!-- Rolling File Appender (JSON) -->
    <!-- ========================================================= -->

    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/application.log</file>

        <append>true</append>

        <immediateFlush>true</immediateFlush>

        <encoder class="net.logstash.logback.encoder.LogstashEncoder">

            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>username</includeMdcKeyName>
            <includeMdcKeyName>method</includeMdcKeyName>
            <includeMdcKeyName>path</includeMdcKeyName>

            <!-- Uncomment when Micrometer Tracing is enabled -->
            <!--
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            -->

        </encoder>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/application-%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>20MB</maxFileSize>

            <maxHistory>30</maxHistory>

            <totalSizeCap>1GB</totalSizeCap>

        </rollingPolicy>

    </appender>

    <!-- ========================================================= -->
    <!-- Development -->
    <!-- ========================================================= -->

    <springProfile name="dev">

        <logger name="com.mahmoudramadan.studentregistration"
                level="DEBUG"/>

        <logger name="org.hibernate.SQL"
                level="DEBUG"/>

        <logger name="org.hibernate.orm.jdbc.bind"
                level="TRACE"/>

        <logger name="com.zaxxer.hikari"
                level="WARN"/>

        <logger name="org.flywaydb"
                level="INFO"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE_DEV"/>
            <appender-ref ref="FILE"/>
        </root>

    </springProfile>

    <!-- ========================================================= -->
    <!-- Production -->
    <!-- ========================================================= -->

    <springProfile name="prod">

        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="FILE"/>
        </root>

    </springProfile>

</configuration>